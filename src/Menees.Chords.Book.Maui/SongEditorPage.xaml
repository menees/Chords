<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="Menees.Chords.Book.Maui.SongEditorPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:local="clr-namespace:Menees.Chords.Book.Maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" Title="Edit Song">
    <Grid Padding="16" RowSpacing="8" RowDefinitions="Auto,Auto,*,Auto">
        <FlexLayout Wrap="Wrap" AlignItems="Center">
            <Label x:Name="heading" Text="Edit Song" FontSize="22" VerticalOptions="Center" />
            <local:FluentIconButton Icon="Save" Description="Save" Clicked="HandleSave" Margin="8,0,0,0" />
            <local:FluentIconButton Icon="Dismiss" Description="Cancel" Clicked="HandleCancel" Margin="8,0,0,0" />
            <HorizontalStackLayout x:Name="newSongActions" IsVisible="False">
                <local:FluentIconButton Icon="PreviewLink" Description="Preview Metadata" Clicked="HandlePreviewMetadata" Margin="8,0,0,0" />
            </HorizontalStackLayout>
        </FlexLayout>
        <VerticalStackLayout Grid.Row="1" Spacing="4">
            <Grid x:Name="metadataGrid" ColumnDefinitions="2*,1.5*,1.5*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="16" RowSpacing="4">
                <Label Text="Catalog title" />
                <Entry x:Name="songTitle" Grid.Row="1" Placeholder="Title" />
                <Grid Grid.Row="2" ColumnDefinitions="*,150" ColumnSpacing="8">
                    <Label Text="Artists (semicolon separated)" />
                    <Label Grid.Column="1" Text="Add existing artist" />
                </Grid>
                <Grid Grid.Row="3" ColumnDefinitions="*,150" ColumnSpacing="8">
                    <Entry x:Name="artists" />
                    <local:MetadataValuePicker x:Name="artistChoices" Grid.Column="1" WidthRequest="150" SemanticProperties.Description="Add existing artist" />
                </Grid>
                <Grid Grid.Row="4" ColumnDefinitions="*,150" ColumnSpacing="8">
                    <Label Text="Tags (semicolon separated)" />
                    <Label Grid.Column="1" Text="Add existing tag" />
                </Grid>
                <Grid Grid.Row="5" ColumnDefinitions="*,150" ColumnSpacing="8">
                    <Entry x:Name="tags" />
                    <local:MetadataValuePicker x:Name="tagChoices" Grid.Column="1" WidthRequest="150" SemanticProperties.Description="Add existing tag" />
                </Grid>
            </Grid>
            <Label x:Name="editingHint" />
        </VerticalStackLayout>
        <Grid x:Name="editorArea" Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="8" RowDefinitions="Auto,*" RowSpacing="4">
            <FlexLayout x:Name="editorToolbar" Grid.ColumnSpan="2" Wrap="Wrap" AlignItems="Center" IsEnabled="False">
                <local:FluentIconButton Icon="Search" Description="Find/Replace (Ctrl+F or Ctrl+H)" Clicked="HandleFind" />
                <local:FluentIconButton Icon="ArrowUndo" Description="Undo (Ctrl+Z)" Clicked="HandleUndo" />
                <local:FluentIconButton Icon="ArrowRedo" Description="Redo (Ctrl+Y or Ctrl+Shift+Z)" Clicked="HandleRedo" />
                <local:FluentIconButton x:Name="revertButton" Icon="ArrowReset" Description="Revert Text" Margin="8,0,8,0" Clicked="HandleRevert" />
                <local:FluentIconSplitButton x:Name="convertButton" Icon="BracesVariable" Description="Convert To ChordPro" Clicked="HandleConvertChordPro" Margin="0,0,8,0" />
                <local:FluentIconToggle x:Name="showPreview" Icon="PreviewLink" Description="Preview current section" CheckedChanged="HandlePreviewChanged" />
                <local:FluentIconButton Icon="ArrowImport" Description="Import Metadata as Directives…" Clicked="HandleImportMetadata" Margin="8,0,0,0" />
            </FlexLayout>
            <WebView Grid.Row="1" x:Name="text" Grid.ColumnSpan="2" />
            <WebView Grid.Row="1" x:Name="preview" Grid.Column="1" IsVisible="False" />
        </Grid>
        <Label x:Name="status" Grid.Row="3" TextColor="DarkRed" />
    </Grid>
</ContentPage>
