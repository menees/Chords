<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="Menees.Chords.Book.Maui.BookReconciliationPage"
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	xmlns:local="clr-namespace:Menees.Chords.Book.Maui" Title="Review Folder Changes">
	<Grid Padding="16" RowSpacing="8" RowDefinitions="Auto,Auto,*,Auto">
		<HorizontalStackLayout Spacing="4">
			<Label Text="Review Folder Changes" FontSize="22" VerticalOptions="Center" />
			<local:FluentIconButton Icon="Dismiss" Description="Close" Clicked="HandleClose" />
		</HorizontalStackLayout>
		<Label Grid.Row="1" Text="Applying updates the book catalog; it never rewrites your sheets. Catalog conflicts keep your edits unless you select Use source value. Missing files are not deleted." />
		<CollectionView x:Name="items" Grid.Row="2" SelectionMode="None">
			<CollectionView.ItemTemplate>
				<DataTemplate x:DataType="local:ReconciliationRow">
					<VerticalStackLayout Padding="8" Spacing="4">
						<Label Text="{Binding Title}" FontAttributes="Bold" />
						<Label Text="{Binding Description}" LineBreakMode="WordWrap" />
						<HorizontalStackLayout IsVisible="{Binding CanChoose}">
							<CheckBox IsChecked="{Binding UseSourceValue, Mode=TwoWay}" />
							<Label Text="Use source value" VerticalOptions="Center" />
						</HorizontalStackLayout>
					</VerticalStackLayout>
				</DataTemplate>
			</CollectionView.ItemTemplate>
		</CollectionView>
		<VerticalStackLayout Grid.Row="3" Spacing="8">
			<Label x:Name="status" />
			<HorizontalStackLayout x:Name="actions" Spacing="8">
				<Button x:Name="apply" Text="Apply Reviewed Changes" Clicked="HandleApply" />
				<Button Text="Refresh Review" Clicked="HandleRefresh" />
			</HorizontalStackLayout>
		</VerticalStackLayout>
	</Grid>
</ContentPage>
