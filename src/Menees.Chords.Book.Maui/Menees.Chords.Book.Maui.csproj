<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<RootNamespace>Menees.Chords.Book.Maui</RootNamespace>
		<ImplicitUsings>enable</ImplicitUsings>
		<TargetFramework Condition="$([MSBuild]::IsOSPlatform('Windows'))">$(MeneesTargetNetApp)-windows10.0.19041.0</TargetFramework>
		<TargetFramework Condition="!$([MSBuild]::IsOSPlatform('Windows'))">$(MeneesTargetNetApp)</TargetFramework>
	</PropertyGroup>
	<PropertyGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
		<OutputType>WinExe</OutputType>
		<UseMaui>true</UseMaui>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<SingleProject>true</SingleProject>
		<SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
		<WindowsPackageType>None</WindowsPackageType>
		<ApplicationTitle>Menees ChordBook</ApplicationTitle>
		<ApplicationId>com.menees.chords.book</ApplicationId>
		<ApplicationDisplayVersion>0.1.0</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>
		<ApplicationIcon>Resources\AppIcon\Generated\chordbook.ico</ApplicationIcon>
		<!-- Maintainer-owned release languages. Resource selection does not constrain song Unicode or regional formatting. -->
		<DefaultLanguage>en-US</DefaultLanguage>
		<NeutralLanguage>$(DefaultLanguage)</NeutralLanguage>
		<SupportedResourceLanguages>en-US;en-GB</SupportedResourceLanguages>
		<SatelliteResourceLanguages>$(SupportedResourceLanguages)</SatelliteResourceLanguages>
		<PublishDocumentationFiles>false</PublishDocumentationFiles>
	</PropertyGroup>
	<ItemGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
		<PackageReference Include="Microsoft.Identity.Client" />
		<PackageReference Include="Microsoft.Identity.Client.Extensions.Msal" />
		<PackageReference Include="Microsoft.Maui.Controls" />
		<PackageReference Include="Microsoft.Web.LibraryManager.Build" PrivateAssets="all" />
		<UpToDateCheckInput Include="libman.json" />
		<Content Include="Resources\AppIcon\Generated\chordbook.ico" Link="Assets\ChordBook.ico" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
		<MauiCss Remove="Resources\Editor\**\*.css" />
		<Content Include="Resources\Editor\**\*" Exclude="Resources\Editor\vendor\**\*" Link="Editor\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
		<EmbeddedResource Include="Resources\Fluent\*.svg" />
		<EmbeddedResource Include="Resources\Icons\*.svg" />
		<Content Include="Resources\Fluent\*.txt" Link="FluentIcons\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
		<Content Include="Resources\Viewer\**\*" Exclude="Resources\Viewer\pdfjs\**\*" Link="Viewer\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
	</ItemGroup>
	<ItemGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
		<ProjectReference Include="..\Menees.Chords.Book.Application\Menees.Chords.Book.Application.csproj" />
		<ProjectReference Include="..\Menees.Chords.Sync.OneDrive\Menees.Chords.Sync.OneDrive.csproj" />
		<ProjectReference Include="..\Menees.Chords.Db\Menees.Chords.Db.csproj" />
		<ProjectReference Include="..\Menees.Chords\Menees.Chords.csproj" />
	</ItemGroup>
	<ItemGroup Condition="!$([MSBuild]::IsOSPlatform('Windows'))">
		<Compile Remove="**\*.cs" />
		<Compile Include="NonWindowsPlaceholder.cs" />
	</ItemGroup>
	<!-- Re-enumerate after restore: a clean checkout has no PDF.js files at project evaluation time. -->
	<Target Name="IncludeRestoredViewerAssets" BeforeTargets="AssignTargetPaths" DependsOnTargets="LibraryManagerRestore"
		Condition="$([MSBuild]::IsOSPlatform('Windows')) And '$(DesignTimeBuild)' != 'true'">
		<ItemGroup>
			<_RestoredViewerAsset Include="Resources\Viewer\pdfjs\**\*" />
			<_RestoredEditorAsset Include="Resources\Editor\vendor\**\*" />
			<Content Include="@(_RestoredEditorAsset)" Link="Editor\vendor\%(_RestoredEditorAsset.RecursiveDir)%(_RestoredEditorAsset.Filename)%(_RestoredEditorAsset.Extension)"
				CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
			<Content Include="@(_RestoredViewerAsset)" Link="Viewer\pdfjs\%(_RestoredViewerAsset.RecursiveDir)%(_RestoredViewerAsset.Filename)%(_RestoredViewerAsset.Extension)"
				CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
		</ItemGroup>
		<Error Condition="!Exists('Resources\Viewer\pdfjs\build\pdf.worker.mjs')" Text="PDF.js assets are missing. Restore the pinned libman.json dependencies before building." />
		<Error Condition="!Exists('Resources\Editor\vendor\view\dist\index.js')" Text="CodeMirror assets are missing. Restore the pinned libman.json dependencies before building." />
	</Target>
	<!-- The .NET satellite filter does not cover native Windows App SDK MUI payloads. Exclude before copying. -->
	<Target Name="SelectSupportedWindowsResourceLanguages" BeforeTargets="AddMicrosoftWindowsAppSDKPayloadFiles"
		DependsOnTargets="ExtractMicrosoftWindowsAppSDKMsixFiles"
		Condition="$([MSBuild]::IsOSPlatform('Windows')) And '$(WindowsAppSDKSelfContained)' == 'true'">
		<ItemGroup>
			<_SupportedWindowsResourceLanguage Include="$(SupportedResourceLanguages)" />
			<_SupportedWindowsMui Include="@(_SupportedWindowsResourceLanguage->'$(MicrosoftWindowsAppSDKMsixContent)\%(Identity)\*.mui')" />
			<MicrosoftWindowsAppSDKFilesExcluded Include="$(MicrosoftWindowsAppSDKMsixContent)\**\*.mui" Exclude="@(_SupportedWindowsMui)" />
			<MicrosoftWindowsAppSDKFilesExcluded Include="$(MicrosoftWindowsAppSDKMsixContent)\**\RestartAgent.exe;$(MicrosoftWindowsAppSDKMsixContent)\**\NPUDetect.dll" />
			<MicrosoftWindowsAppSDKFilesExcluded Include="$(MicrosoftWindowsAppSDKMsixContent)\**\WindowsAppRuntime.png;$(MicrosoftWindowsAppSDKMsixContent)\**\workloads*.json" />
		</ItemGroup>
		<Error Condition="!$([System.String]::Copy(';$(SupportedResourceLanguages);').Contains(';$(DefaultLanguage);'))"
			Text="The default resource language must be included in SupportedResourceLanguages." />
		<Error Condition="!Exists('$(MicrosoftWindowsAppSDKMsixContent)\en-us\Microsoft.ui.xaml.dll.mui')"
			Text="The Windows App SDK English fallback resources are missing." />
	</Target>
	<!-- Remove unused SDK assets and API documentation from every Windows publish, including direct dotnet publish. -->
	<Target Name="ExcludeUnusedPublishedAssets" AfterTargets="ComputeFilesToPublish"
		Condition="$([MSBuild]::IsOSPlatform('Windows'))">
		<ItemGroup>
			<ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
				Condition="'%(ResolvedFileToPublish.Filename)%(ResolvedFileToPublish.Extension)' == 'RestartAgent.exe'
					Or '%(ResolvedFileToPublish.Filename)%(ResolvedFileToPublish.Extension)' == 'NPUDetect.dll'
					Or '%(ResolvedFileToPublish.Filename)%(ResolvedFileToPublish.Extension)' == 'createdump.exe'
					Or '%(ResolvedFileToPublish.Filename)%(ResolvedFileToPublish.Extension)' == 'WindowsAppRuntime.png'
					Or ('%(ResolvedFileToPublish.Extension)' == '.json' And $([System.String]::Copy('%(ResolvedFileToPublish.Filename)').StartsWith('workloads')))
					Or '%(ResolvedFileToPublish.Filename)%(ResolvedFileToPublish.Extension)' == 'Menees.Chords.Db.xml'
					Or '%(ResolvedFileToPublish.Filename)%(ResolvedFileToPublish.Extension)' == 'Menees.Chords.Sync.OneDrive.xml'
					Or '%(ResolvedFileToPublish.Filename)%(ResolvedFileToPublish.Extension)' == 'Menees.Chords.Sync.xml'
					Or '%(ResolvedFileToPublish.Filename)%(ResolvedFileToPublish.Extension)' == 'Menees.Chords.xml'" />
		</ItemGroup>
	</Target>
</Project>
