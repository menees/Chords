<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<RootNamespace>Menees.Chords.Book.Maui</RootNamespace>
		<ImplicitUsings>enable</ImplicitUsings>
		<TargetFramework Condition="$([MSBuild]::IsOSPlatform('Windows'))">$(MeneesTargetNetApp)-windows10.0.19041.0</TargetFramework>
		<TargetFramework Condition="!$([MSBuild]::IsOSPlatform('Windows'))">$(MeneesTargetNetApp)</TargetFramework>
	</PropertyGroup>
	<PropertyGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
		<OutputType>WinExe</OutputType>
		<UseMaui>true</UseMaui>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<SingleProject>true</SingleProject>
		<SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
		<WindowsPackageType>None</WindowsPackageType>
		<ApplicationTitle>ChordBook</ApplicationTitle>
		<ApplicationId>com.menees.chords.book</ApplicationId>
		<ApplicationDisplayVersion>0.1.0</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>
	</PropertyGroup>
	<ItemGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
		<PackageReference Include="Microsoft.Maui.Controls" />
		<PackageReference Include="Microsoft.Web.LibraryManager.Build" PrivateAssets="all" />
		<UpToDateCheckInput Include="libman.json" />
		<MauiCss Remove="Resources\Editor\**\*.css" />
		<Content Include="Resources\Editor\**\*" Exclude="Resources\Editor\vendor\**\*" Link="Editor\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
		<EmbeddedResource Include="Resources\Fluent\*.svg" />
		<Content Include="Resources\Fluent\*.txt" Link="FluentIcons\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
		<Content Include="Resources\Viewer\**\*" Exclude="Resources\Viewer\pdfjs\**\*" Link="Viewer\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
	</ItemGroup>
	<ItemGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
		<ProjectReference Include="..\Menees.Chords.Book.Application\Menees.Chords.Book.Application.csproj" />
		<ProjectReference Include="..\Menees.Chords.Db\Menees.Chords.Db.csproj" />
		<ProjectReference Include="..\Menees.Chords\Menees.Chords.csproj" />
	</ItemGroup>
	<ItemGroup Condition="!$([MSBuild]::IsOSPlatform('Windows'))">
		<Compile Remove="**\*.cs" />
		<Compile Include="NonWindowsPlaceholder.cs" />
	</ItemGroup>
	<!-- Re-enumerate after restore: a clean checkout has no PDF.js files at project evaluation time. -->
	<Target Name="IncludeRestoredViewerAssets" BeforeTargets="AssignTargetPaths" DependsOnTargets="LibraryManagerRestore"
		Condition="$([MSBuild]::IsOSPlatform('Windows')) And '$(DesignTimeBuild)' != 'true'">
		<ItemGroup>
			<_RestoredViewerAsset Include="Resources\Viewer\pdfjs\**\*" />
			<_RestoredEditorAsset Include="Resources\Editor\vendor\**\*" />
			<Content Include="@(_RestoredEditorAsset)" Link="Editor\vendor\%(_RestoredEditorAsset.RecursiveDir)%(_RestoredEditorAsset.Filename)%(_RestoredEditorAsset.Extension)"
				CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
			<Content Include="@(_RestoredViewerAsset)" Link="Viewer\pdfjs\%(_RestoredViewerAsset.RecursiveDir)%(_RestoredViewerAsset.Filename)%(_RestoredViewerAsset.Extension)"
				CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
		</ItemGroup>
		<Error Condition="!Exists('Resources\Viewer\pdfjs\build\pdf.worker.mjs')" Text="PDF.js assets are missing. Restore the pinned libman.json dependencies before building." />
		<Error Condition="!Exists('Resources\Editor\vendor\view\dist\index.js')" Text="CodeMirror assets are missing. Restore the pinned libman.json dependencies before building." />
	</Target>
</Project>
