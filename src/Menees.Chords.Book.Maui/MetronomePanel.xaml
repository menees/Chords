<?xml version="1.0" encoding="utf-8" ?>
<ContentView x:Class="Menees.Chords.Book.Maui.MetronomePanel"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:Menees.Chords.Book.Maui">
    <VerticalStackLayout Padding="8,4" Spacing="4" BackgroundColor="{DynamicResource AppSurface}">
        <FlexLayout Wrap="Wrap" AlignItems="Center">
            <HorizontalStackLayout Spacing="4" Margin="0,0,12,0">
                <Label Text="BPM" VerticalOptions="Center" />
                <Entry x:Name="bpm" WidthRequest="64" Keyboard="Numeric" SemanticProperties.Description="Tempo, 20 to 300 BPM" />
            </HorizontalStackLayout>
            <HorizontalStackLayout Spacing="4" Margin="0,0,12,0">
                <Label Text="Meter" VerticalOptions="Center" />
                <Entry x:Name="beats" WidthRequest="44" Keyboard="Numeric" SemanticProperties.Description="Beats per measure, 1 to 16" />
                <Label Text="/" VerticalOptions="Center" />
                <Picker x:Name="beatUnit" WidthRequest="66" SemanticProperties.Description="Beat unit" />
            </HorizontalStackLayout>
            <HorizontalStackLayout Spacing="4" Margin="0,0,12,0">
                <Label Text="Clicks/beat" VerticalOptions="Center" />
                <Picker x:Name="subdivision" WidthRequest="112" />
            </HorizontalStackLayout>
            <Picker x:Name="sound" WidthRequest="174" Margin="0,0,12,0" SemanticProperties.Description="Metronome sound" />
            <local:FluentIconButton x:Name="toggle" Clicked="HandleToggle" Margin="0,0,8,0" />
            <local:FluentIconButton x:Name="closePanel" Clicked="HandleClose" />
        </FlexLayout>
        <FlexLayout Wrap="Wrap" AlignItems="Center">
            <HorizontalStackLayout Spacing="4" Margin="0,0,12,0">
                <CheckBox Margin="-6,0,-10,0" x:Name="audio" /><Label Text="Audio" VerticalOptions="Center" />
            </HorizontalStackLayout>
            <HorizontalStackLayout Spacing="4" Margin="0,0,12,0">
                <CheckBox Margin="-6,0,-10,0" x:Name="visual" /><Label Text="Visual" VerticalOptions="Center" />
            </HorizontalStackLayout>
            <HorizontalStackLayout Spacing="4" Margin="0,0,12,0">
                <CheckBox Margin="-6,0,-10,0" x:Name="accent" /><Label Text="Accent beat 1" VerticalOptions="Center" />
            </HorizontalStackLayout>
            <HorizontalStackLayout Spacing="4" Margin="0,0,12,0">
                <Label Text="Volume" VerticalOptions="Center" /><Slider x:Name="volume" WidthRequest="90" Minimum="0" Maximum="1" />
            </HorizontalStackLayout>
            <local:MetronomeBeatView x:Name="pulse" Margin="0,0,12,0" VerticalOptions="Center" />
            <local:FluentIconButton x:Name="saveSettings" Clicked="HandleSave" Margin="0,0,8,0" />
            <local:FluentIconButton x:Name="resetSettings" Icon="ArrowReset" Description="Reset" Clicked="HandleReset" />
            <HorizontalStackLayout x:Name="transitionSettings" Spacing="4" Margin="8,0,0,0">
                <CheckBox Margin="-6,0,-10,0" x:Name="stopOnTransition" /><Label Text="Stop at next entry" VerticalOptions="Center" />
            </HorizontalStackLayout>
        </FlexLayout>

        <Label x:Name="status" FontSize="12" />
    </VerticalStackLayout>
</ContentView>
