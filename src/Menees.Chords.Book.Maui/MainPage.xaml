<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
	x:Class="Menees.Chords.Book.Maui.MainPage"
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	xmlns:local="clr-namespace:Menees.Chords.Book.Maui"
	Title="ChordBook">
	<Grid>
		<Grid x:Name="ManagementSurface" RowDefinitions="Auto,Auto,Auto,*,Auto" BackgroundColor="{DynamicResource AppBackground}">
			<Grid Padding="8" ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto" ColumnSpacing="8" BackgroundColor="{DynamicResource AppSurface}">
				<local:FluentIconButton x:Name="ManagementBackButton" IsVisible="False" Icon="ArrowLeft" Description="Back" Clicked="HandleBackClicked" />
				<Label x:Name="BookName" Grid.Column="1" FontSize="22" FontAttributes="Bold" VerticalOptions="Center" />

				<local:FluentIconButton x:Name="NewBookButton" Grid.Column="2" Icon="BookAdd" Description="New Book" Clicked="HandleNewBookClicked" />
				<local:OpenBookSplitButton x:Name="OpenBookButton" Grid.Column="3" HeightRequest="32" VerticalOptions="Center" Clicked="HandleOpenBookClicked" />
				<local:FluentIconButton x:Name="RenameBookButton" Grid.Column="4" Icon="Settings" Description="Options" Clicked="HandleBookActionsClicked" />
				<local:FluentIconButton x:Name="ImportButton" Grid.Column="5" Icon="ArrowImport" Description="Import" Clicked="HandleImportClicked" />
			</Grid>

			<local:BookTabs x:Name="ManagementTabs" Grid.Row="1" HeightRequest="48" SelectionChanged="HandleManagementTabChanged" />

			<Grid x:Name="SongToolbar" Grid.Row="2" Padding="12,4" ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="8" BackgroundColor="{DynamicResource AppBackground}">
				<local:FluentIconButton Icon="Filter" Description="Views" Clicked="HandleViewActionsClicked" />
				<SearchBar x:Name="SongSearch" Grid.Column="1" Placeholder="Search titles, artists, tags, and metadata" TextChanged="HandleSearchTextChanged" />
				<local:ArchiveToggle x:Name="ShowArchived" Grid.Column="2" CheckedChanged="HandleShowArchivedChanged" />
				<local:FluentIconButton Grid.Column="3" Icon="MultiselectLtr" Description="Select" Clicked="HandleSelectSongsClicked" />
				<local:FluentIconButton Grid.Column="4" Icon="DocumentOnePageAdd" Description="New Song" Clicked="HandleNewSongClicked" />
			</Grid>

			<Grid x:Name="SongSelectionToolbar" Grid.Row="2" IsVisible="False" Padding="12,4" ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="8" BackgroundColor="{DynamicResource AppSurface}">
				<Label x:Name="SelectedSongCount" FontAttributes="Bold" FontSize="18" VerticalOptions="Center" />
				<local:FluentIconButton Grid.Column="2" Icon="LayerDiagonalAdd" Description="Add to Setlist" Clicked="HandleAddSelectedSongsClicked" />
				<local:FluentIconButton x:Name="EditSelectedSongButton" Grid.Column="3" Icon="EditLineHorizontal3" Description="Song" IsEnabled="False" Clicked="HandleEditSelectedSongClicked" />
                <Button x:Name="ArchiveSelectedSongsButton" Grid.Column="4" Text="Archive" IsEnabled="False" Clicked="HandleArchiveSelectedSongsClicked" />
                <Button x:Name="RestoreSelectedSongsButton" Grid.Column="5" Text="Restore" IsEnabled="False" Clicked="HandleRestoreSelectedSongsClicked" />
                <Button x:Name="DeleteSelectedSongsButton" Grid.Column="6" Text="Delete Permanently…" IsEnabled="False" Clicked="HandleDeleteSelectedSongsClicked" />
                <Button Grid.Column="7" Text="Cancel" Clicked="HandleCancelSongSelectionClicked" />
			</Grid>

			<Grid SizeChanged="HandleJumpViewportChanged" x:Name="SongSurface" Grid.Row="3" ColumnDefinitions="*,Auto">
				<CollectionView
					x:Name="SongList"
					Margin="8,0,2,0"
					IsGrouped="True"
					ItemSizingStrategy="MeasureAllItems"
					SelectionMode="Single"
					SelectionChanged="HandleSongSelectionChanged">
					<CollectionView.ItemsLayout>
						<LinearItemsLayout Orientation="Vertical" ItemSpacing="0" />
					</CollectionView.ItemsLayout>
					<CollectionView.GroupHeaderTemplate>
						<DataTemplate x:DataType="local:SongGroup">
							<Label
								Text="{Binding Key}"
								Padding="8,2"
								FontAttributes="Bold"
								TextColor="{DynamicResource AppText}"
								BackgroundColor="{DynamicResource AppSection}" />
						</DataTemplate>
					</CollectionView.GroupHeaderTemplate>
					<CollectionView.ItemTemplate>
						<DataTemplate x:DataType="local:SongRow">
							<Grid Padding="8,4">
								<Label
									Text="{Binding DisplayText}" TextColor="{DynamicResource AppText}" FontAttributes="{Binding RowFontAttributes}"
									FontSize="14"
									LineBreakMode="WordWrap" />
							</Grid>
						</DataTemplate>
					</CollectionView.ItemTemplate>
				</CollectionView>

				<ScrollView Grid.Column="1" WidthRequest="56" MinimumHeightRequest="0" Orientation="Vertical" VerticalScrollBarVisibility="Always">
					<VerticalStackLayout x:Name="JumpLetters" Spacing="0" Padding="2,0" />
				</ScrollView>
			</Grid>

			<Grid x:Name="SetlistSurface" Grid.Row="2" Grid.RowSpan="2" IsVisible="False">
				<Grid x:Name="SetlistOverview" RowDefinitions="Auto,*">
					<Grid Padding="12,4" ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
						<Label x:Name="SetlistHeading" Text="Setlists" FontAttributes="Bold" FontSize="20" VerticalOptions="Center" />
						<SearchBar x:Name="SetlistSearch" Grid.Column="1" Placeholder="Search setlist names, dates, and notes" TextChanged="HandleSetlistSearchTextChanged" />
						<local:ArchiveToggle x:Name="ShowArchivedSetlists" Grid.Column="2" CheckedChanged="HandleShowArchivedSetlistsChanged" />
						<local:FluentIconButton Grid.Column="3" Icon="LayerDiagonal" Description="New Setlist" Clicked="HandleNewSetlistClicked" />
					</Grid>
					<Grid Grid.Row="1" ColumnDefinitions="*,Auto" SizeChanged="HandleJumpViewportChanged">
						<CollectionView
							x:Name="SetlistList"
							Margin="8,0,2,0"
							IsGrouped="True"
							ItemSizingStrategy="MeasureAllItems"
							SelectionMode="Single"
							SelectionChanged="HandleSetlistSelected">
							<CollectionView.GroupHeaderTemplate>
								<DataTemplate x:DataType="local:SetlistGroup">
									<Label Text="{Binding Key}" Padding="8,2" FontAttributes="Bold" TextColor="{DynamicResource AppText}" BackgroundColor="{DynamicResource AppSection}" />
								</DataTemplate>
							</CollectionView.GroupHeaderTemplate>
							<CollectionView.ItemTemplate>
								<DataTemplate x:DataType="local:SetlistRow">
									<Label Text="{Binding DisplayText}" TextColor="{DynamicResource AppText}" FontAttributes="{Binding RowFontAttributes}" Padding="8,4" FontSize="14" LineBreakMode="WordWrap" />
								</DataTemplate>
							</CollectionView.ItemTemplate>
						</CollectionView>
						<ScrollView Grid.Column="1" WidthRequest="56" MinimumHeightRequest="0" Orientation="Vertical" VerticalScrollBarVisibility="Always">
							<VerticalStackLayout x:Name="SetlistJumpLetters" Spacing="0" Padding="2,0" />
						</ScrollView>
					</Grid>
				</Grid>

				<Grid x:Name="SetlistDetail" IsVisible="False" RowDefinitions="Auto,*">
					<Grid Padding="12,4" ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="8">
						<VerticalStackLayout VerticalOptions="Center" Spacing="0">
							<Label x:Name="SetlistDetailName" FontAttributes="Bold" FontSize="20" />
							<Label x:Name="SetlistDetailMetadata" FontSize="12" TextColor="{DynamicResource AppMuted}" />
						</VerticalStackLayout>
						<Button x:Name="AddSetlistSongsButton" Grid.Column="1" Text="Add Songs…" Clicked="HandleAddSetlistSongsClicked" />
						<Button x:Name="RenameSetlistButton" Grid.Column="2" Text="Rename…" Clicked="HandleRenameSetlistClicked" />
						<Button x:Name="EditSetlistButton" Grid.Column="3" Text="Edit" Clicked="HandleEditSetlistClicked" />
						<Button x:Name="ArchiveSetlistButton" Grid.Column="4" Text="Archive" IsVisible="False" Clicked="HandleArchiveSetlistClicked" />
                        <Button x:Name="DeleteSetlistButton" Grid.Column="5" Text="Delete Permanently…" IsVisible="False" Clicked="HandleDeleteSetlistClicked" />
					</Grid>
					<CollectionView
						x:Name="SetlistEntries"
						Grid.Row="1"
						Margin="8,0"
						SelectionMode="Single"
						ReorderCompleted="HandleSetlistReorderCompleted" SelectionChanged="HandleSetlistEntrySelected">
						<CollectionView.EmptyView>
							<Label Margin="12" Text="This setlist is empty. Choose Add Songs to begin building it." />
						</CollectionView.EmptyView>
						<CollectionView.ItemTemplate>
							<DataTemplate x:DataType="local:SetlistEntryRow">
								<Grid ColumnDefinitions="64,*,Auto,Auto,Auto,Auto" Padding="8,3" ColumnSpacing="5">

									<Label Text="{Binding Position}" IsVisible="{Binding IsViewing}" HorizontalTextAlignment="Center" VerticalOptions="Center" />
                                    <local:PositionEntry Text="{Binding Position, Mode=OneWay}" IsVisible="{Binding IsEditing}" Keyboard="Numeric" HorizontalTextAlignment="Center" PositionSubmitted="HandleSetlistPositionCompleted" Unfocused="HandleSetlistPositionUnfocused" SemanticProperties.Description="Song position, starting at 1. Press Enter to move." />
									<Label Grid.Column="1" Text="{Binding DisplayText}" TextColor="{DynamicResource AppText}" FontAttributes="{Binding Song.RowFontAttributes}" FontSize="14" LineBreakMode="WordWrap" VerticalOptions="Center" />
									<Button Grid.Column="2" Text="↑" IsVisible="{Binding IsEditing}" IsEnabled="{Binding CanMoveUp}" CommandParameter="{Binding .}" Clicked="HandleMoveSetlistEntryUpClicked" />
									<Button Grid.Column="3" Text="↓" IsVisible="{Binding IsEditing}" IsEnabled="{Binding CanMoveDown}" CommandParameter="{Binding .}" Clicked="HandleMoveSetlistEntryDownClicked" />
									<Button Grid.Column="4" Text="Remove" IsVisible="{Binding IsEditing}" CommandParameter="{Binding .}" Clicked="HandleRemoveSetlistEntryClicked" />
									<Button Grid.Column="5" Text="Settings…" IsVisible="{Binding IsEditing}" CommandParameter="{Binding .}" Clicked="HandleEntrySettingsClicked" />
								</Grid>
							</DataTemplate>
						</CollectionView.ItemTemplate>
					</CollectionView>
				</Grid>
			</Grid>

			<Grid Grid.Row="4" Padding="12,6" ColumnDefinitions="*,Auto" BackgroundColor="{DynamicResource AppSurface}">
				<Label x:Name="Status" Text="Starting ChordBook…" TextColor="{DynamicResource AppText}" LineBreakMode="TailTruncation" />
				<Label
					x:Name="BookPath"
					Grid.Column="1"
					MaximumWidthRequest="700"
					TextColor="{DynamicResource AppMuted}"
					TextDecorations="Underline"
					LineBreakMode="MiddleTruncation">
					<Label.GestureRecognizers>
						<TapGestureRecognizer Tapped="HandleBookPathTapped" />
					</Label.GestureRecognizers>
				</Label>
			</Grid>
		</Grid>

		<Grid x:Name="PerformanceSurface" IsVisible="False" RowDefinitions="Auto,Auto,*" BackgroundColor="Black">
			<FlexLayout Padding="8" Wrap="Wrap" AlignItems="Center" BackgroundColor="{DynamicResource AppSurface}">
				<local:FluentIconButton Margin="3,0" FlexLayout.Shrink="0" Icon="ArrowLeft" Description="Back" Clicked="HandleBackClicked" />
				<local:FluentIconButton Margin="3,0" FlexLayout.Shrink="0" x:Name="PreviousSongButton" Icon="Previous" Description="Previous" Clicked="HandlePreviousSongClicked" />
				<local:FluentIconButton Margin="3,0" FlexLayout.Shrink="0" x:Name="PerformanceAddButton" Icon="LayerDiagonalAdd" Description="Add to Setlist" Clicked="HandleAddToSetlistClicked" />
				<Label
					x:Name="PerformanceTitle" FlexLayout.Grow="1" FlexLayout.Basis="160"
					FontSize="18"
					FontAttributes="Bold"
					TextColor="{DynamicResource AppText}"
					HorizontalTextAlignment="Center"
					VerticalOptions="Center"
					LineBreakMode="TailTruncation" />
				<Label x:Name="PerformancePosition" TextColor="{DynamicResource AppMuted}" VerticalOptions="Center" />
				<local:FluentIconButton Margin="3,0" FlexLayout.Shrink="0" x:Name="NextSongButton" Icon="ArrowRight" Description="Next" Clicked="HandleNextSongClicked" />
                <local:FluentIconButton Margin="3,0" FlexLayout.Shrink="0" x:Name="PerformanceSongButton" Icon="EditLineHorizontal3" Description="Song" Clicked="HandleEditCurrentSongClicked" />
                <local:FluentIconButton Margin="3,0" FlexLayout.Shrink="0" x:Name="PerformanceMetronomeButton" Icon="SoundWaveCircleSparkle" Description="Metronome" Clicked="HandleMetronomeClicked" />
				<local:FluentIconButton Margin="3,0" FlexLayout.Shrink="0" x:Name="PerformanceLockButton" Icon="LockClosed" Description="Lock" Clicked="HandlePerformanceLockClicked" />
				<HorizontalStackLayout Spacing="4" Margin="6,0">
					<Label Text="Notation" VerticalOptions="Center" />
					<Picker x:Name="QuickNotation" WidthRequest="125" SelectedIndexChanged="HandleQuickDisplayChanged" />
					<Label Text="Transpose" VerticalOptions="Center" />
					<Picker x:Name="QuickTranspose" WidthRequest="72" SelectedIndexChanged="HandleQuickDisplayChanged" ToolTipProperties.Text="Semitones relative to the current song/entry settings" />
				</HorizontalStackLayout>
				<local:MetronomeBeatView x:Name="PerformanceBeats" Margin="6,0" FlexLayout.Shrink="0" IsVisible="False" />
			</FlexLayout>
			<ContentView x:Name="MetronomeHost" Grid.Row="1" />
			<WebView
				x:Name="SongViewer"
				Grid.Row="2"
				Navigating="HandleSongViewerNavigating"
				Navigated="HandleSongViewerNavigated"
				Unloaded="HandleSongViewerUnloaded"
				SizeChanged="HandleSongViewerSizeChanged" />
		</Grid>
	</Grid>
</ContentPage>
