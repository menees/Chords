<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="Menees.Chords.Book.Maui.SongFilesPage"
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	xmlns:local="clr-namespace:Menees.Chords.Book.Maui" Title="Song Sheets">
	<Grid Padding="8" RowSpacing="8" RowDefinitions="Auto,Auto,*,Auto">
		<local:ScreenHeader BackRequested="HandleClose">
			<Label x:Name="heading" FontSize="22" VerticalOptions="Center" />
		</local:ScreenHeader>
		<FlexLayout x:Name="actions" Grid.Row="1" Wrap="Wrap" AlignItems="Center">
			<local:FluentIconButton x:Name="add" Icon="DocumentOnePageAdd" Description="Add Sheets…" Clicked="HandleAdd" Margin="0,0,8,4" />
			<local:FluentIconButton x:Name="prefer" Icon="Star" Description="Make Default" Clicked="HandlePrefer" Margin="0,0,8,4" />
			<Button x:Name="compare" Text="Compare Sheets…" Clicked="HandleCompare" IsEnabled="False" Opacity="0.4" Margin="0,0,8,4" />
			<local:FluentIconButton x:Name="edit" Icon="EditLineHorizontal3" Description="Edit Sheet…" Clicked="HandleEdit" Margin="0,0,8,4" />
			<local:FluentIconButton x:Name="up" Icon="ArrowUp" Description="Move Up" Clicked="HandleUp" Margin="0,0,8,4" />
			<local:FluentIconButton x:Name="down" Icon="ArrowDown" Description="Move Down" Clicked="HandleDown" Margin="0,0,8,4" />
			<local:FluentIconButton x:Name="rename" Icon="Rename" Description="Rename…" Clicked="HandleRename" Margin="0,0,8,4" />
			<local:FluentIconButton x:Name="archive" Icon="Archive" Description="Archive" Clicked="HandleArchive" Margin="0,0,8,4" />
			<local:FluentIconButton x:Name="delete" Icon="Delete" Description="Delete Permanently…" Clicked="HandleDelete" Margin="0,0,8,4" />
		</FlexLayout>
		<CollectionView x:Name="files" Grid.Row="2" SelectionMode="Single" SelectionChanged="HandleSelectionChanged">
			<CollectionView.EmptyView><Label Text="No sheets. Add a text chart or PDF to this song." /></CollectionView.EmptyView>
			<CollectionView.ItemTemplate>
				<DataTemplate x:DataType="local:SongFileRow">
					<VerticalStackLayout Padding="8" Spacing="2">
						<Label Text="{Binding Name}" FontAttributes="Bold" LineBreakMode="WordWrap" />
						<Label Text="{Binding Details}" FontSize="12" />
					</VerticalStackLayout>
				</DataTemplate>
			</CollectionView.ItemTemplate>
		</CollectionView>
		<Label x:Name="status" Grid.Row="3" Text="The first active sheet is the default. Reordering and archiving do not change sheet content." />
	</Grid>
</ContentPage>
