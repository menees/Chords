<?xml version="1.0" encoding="utf-8" ?>
<Application x:Class="Menees.Chords.Book.Maui.App"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <Color x:Key="AppBackground">#FAFAFA</Color>
            <Color x:Key="AppSurface">#F0F0F0</Color>
            <Color x:Key="AppSection">#E0E0E0</Color>
            <Color x:Key="AppText">#202020</Color>
            <Color x:Key="AppMuted">#606060</Color>
            <Color x:Key="AppControl">#FFFFFF</Color>
            <Color x:Key="ChordAccent">#0078D4</Color>
            <Color x:Key="ChordAccentBeat">#C43E1C</Color>
            <Style TargetType="ContentPage" ApplyToDerivedTypes="True">
                <Setter Property="BackgroundColor" Value="{DynamicResource AppBackground}" />
            </Style>
            <Style TargetType="Button">
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="Padding" Value="10,4" />
                <Setter Property="MinimumHeightRequest" Value="32" />
                <Setter Property="VerticalOptions" Value="Center" />
                <Setter Property="TextColor" Value="{DynamicResource AppText}" />
                <Setter Property="BackgroundColor" Value="{DynamicResource AppControl}" />
            </Style>
            <Style TargetType="Label">
                <Setter Property="FontFamily" Value="Segoe UI" />
                <Setter Property="TextColor" Value="{DynamicResource AppText}" />
            </Style>
            <Style TargetType="CheckBox">
                <Setter Property="Color" Value="{DynamicResource ChordAccent}" />
                <Setter Property="WidthRequest" Value="40" />
                <Setter Property="HeightRequest" Value="32" />
                <Setter Property="MinimumWidthRequest" Value="0" />
                <Setter Property="VerticalOptions" Value="Center" />
            </Style>
            <Style TargetType="Entry">
                <Setter Property="TextColor" Value="{DynamicResource AppText}" />
                <Setter Property="BackgroundColor" Value="{DynamicResource AppControl}" />
                <Setter Property="VerticalOptions" Value="Center" />
            </Style>
            <Style TargetType="Editor">
                <Setter Property="TextColor" Value="{DynamicResource AppText}" />
                <Setter Property="BackgroundColor" Value="{DynamicResource AppControl}" />
            </Style>
            <Style TargetType="Picker">
                <Setter Property="TextColor" Value="{DynamicResource AppText}" />
                <Setter Property="BackgroundColor" Value="{DynamicResource AppControl}" />
                <Setter Property="VerticalOptions" Value="Center" />
            </Style>
            <Style TargetType="SearchBar">
                <Setter Property="TextColor" Value="{DynamicResource AppText}" />
                <Setter Property="PlaceholderColor" Value="{DynamicResource AppMuted}" />
                <Setter Property="BackgroundColor" Value="{DynamicResource AppControl}" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>