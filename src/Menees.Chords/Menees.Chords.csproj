<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>$(MeneesTargetNetCore)</TargetFramework>
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<Description>Helper types for parsing chord sheets and ChordPro files and converting them to other formats.</Description>
		<PackageReadmeFile>README.md</PackageReadmeFile>
	</PropertyGroup>

	<ItemGroup>
		<EmbeddedResource Include="Formatters\Html\Formatter.css" LogicalName="Menees.Chords.Formatters.Html.Formatter.css" />
		<EmbeddedResource Include="Formatters\Html\Formatter.js" LogicalName="Menees.Chords.Formatters.Html.Formatter.js" />
		<InternalsVisibleTo Include="Menees.Chords.Tests" />
		<None Include="../../README.md" Pack="true" PackagePath="/" />
	</ItemGroup>
</Project>
